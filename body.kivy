										size_hint: None, None
										size: dp(130), dp(130)
										pos_hint: {'center_x': 0.5, 'center_y': 0.6}
					Card:
						BoxLayout:
							orientation: 'horizontal'
							padding: 0, 0, 0, 0
							BoxLayout:
								orientation: 'vertical'
								size_hint_x: 0.6
								padding: dp(20), dp(30), dp(10), 0
								spacing: dp(10)
								Label:
									text: 'Educate a friend about carbon impact'
									font_size: '16sp'
									color: 0, 0, 0, 1
									bold: True
								Label:
									text: 'Teaching someone\ndoubles the reach of your\nactions — awareness\ndrives culture change.'
									font_size: '10sp'
									color: 0, 0, 0, 1
								BoxLayout:
									orientation: 'horizontal'
									spacing: dp(8)
									Badge:
										source: 'shadowv1.png'
										text: '400g'
									Badge:
										source: 'shadowv2.png'
										text: '+15'
								BoxLayout:
