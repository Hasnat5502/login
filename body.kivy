								RelativeLayout:
									padding: 0, dp(30), 0, 0
									Image:
										source: 'card42shadow.png'
										size_hint: None, None
										size: dp(150), dp(150)
										pos_hint: {'center_x': 0.5, 'center_y': 0.6}
									Image:
										source: 'card41png.png'
										size_hint: None, None
										size: dp(130), dp(130)
										pos_hint: {'center_x': 0.5, 'center_y': 0.6}
						Widget:
							size_hint_x: None
							width: dp(60)
			SectionTitle:
				text: 'Plastic Free!'
				left_padding: dp(60)
			CardRow:
				BoxLayout:
					orientation: 'horizontal'
					size_hint_x: None
					width: self.minimum_width
					spacing: dp(120)
					Widget:
						size_hint_x: None
						width: dp(60)
					Card:
						BoxLayout:
							orientation: 'horizontal'
							padding: 0, 0, 0, 0
							BoxLayout:
								orientation: 'vertical'
								size_hint_x: 0.5
								padding: dp(20), dp(30), dp(10), 0
								spacing: dp(10)
								Label:
									text: 'Drink Tap water instead of bottled'
									font_size: '16sp'
									color: 0, 0, 0, 1
									bold: True
								Label:
