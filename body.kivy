								RelativeLayout:
									padding: 0, dp(30), 0, 0
									Image:
										source: 'walkshadow.png'
										size_hint: None, None
										size: dp(150), dp(150)
										pos_hint: {'center_x': 0.5, 'center_y': 0.6}
									Image:
										source: 'walk.png'
										size_hint: None, None
										size: dp(130), dp(130)
										pos_hint: {'center_x': 0.5, 'center_y': 0.6}
					Card:
						BoxLayout:
							orientation: 'horizontal'
							padding: 0, 0, 0, 0
							BoxLayout:
								orientation: 'vertical'
								size_hint_x: 0.6
								padding: dp(20), dp(30), dp(10), 0
								spacing: dp(10)
								Label:
									text: 'Use energy-saving mode on devices'
									font_size: '16sp'
									color: 0, 0, 0, 1
									bold: True
								Label:
									text: 'Lower screen brightness,\nreduce refresh rates, and\nactivate eco-mode on\nyour laptop or phone.'
									font_size: '10sp'
									color: 0, 0, 0, 1
								BoxLayout:
									orientation: 'horizontal'
									spacing: dp(8)
									Badge:
										source: 'shadowv1.png'
										text: '60g'
									Badge:
										source: 'shadowv2.png'
										text: '+5'
								BoxLayout:
									orientation: 'horizontal'
									spacing: dp(15)
									padding: dp(20), 0, 0, 0
									Image:
										source: 'card31.png'
									Image:
										source: 'card32.png'
							BoxLayout:
								size_hint_x: 0.4
